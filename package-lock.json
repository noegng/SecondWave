{
  "name": "secondwave",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "secondwave",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/cli": {
      "name": "@secondwave/cli",
      "version": "0.0.0"
    },
    "node_modules/@secondwave/analyst": {
      "resolved": "packages/analyst",
      "link": true
    },
    "node_modules/@secondwave/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@secondwave/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@secondwave/orderbook": {
      "resolved": "packages/orderbook",
      "link": true
    },
    "node_modules/@secondwave/settlement": {
      "resolved": "packages/settlement",
      "link": true
    },
    "node_modules/@secondwave/vault": {
      "resolved": "packages/vault",
      "link": true
    },
    "packages/analyst": {
      "name": "@secondwave/analyst",
      "version": "0.0.0",
      "dependencies": {
        "@secondwave/core": "*"
      }
    },
    "packages/core": {
      "name": "@secondwave/core",
      "version": "0.0.0"
    },
    "packages/orderbook": {
      "name": "@secondwave/orderbook",
      "version": "0.0.0"
    },
    "packages/settlement": {
      "name": "@secondwave/settlement",
      "version": "0.0.0"
    },
    "packages/vault": {
      "name": "@secondwave/vault",
      "version": "0.0.0"
    }
  }
}
