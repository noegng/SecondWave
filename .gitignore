# dépendances
node_modules/
.pnp.*

# secrets & état local — ⚠️ les scripts génèrent des wallets avec seeds en clair
.env
.env.*
state*.json
*.seed
*.key

# outil XRPL DevEx (chacun l'installe localement, voir README)
# les skills sont des symlinks vers xrpl-devex-hook/ -> inutilisables chez l'autre
xrpl-devex-hook/
.xrpl-devex/
.claude/settings.local.json
.claude/skills/
.codex/skills/
.cursor/skills/
.grok/skills/

# build & divers
# Ne PAS ignorer `apps/web/dist` : le dashboard Vercel le force encore
# comme Output Directory. `dist/` le faisait sauter → deploy vert, 0 fichier,
# 404 DEPLOYMENT_NOT_FOUND.
build/
coverage/
*.log
.DS_Store

# état local du carnet (régénérable)
orderbook.json

# sondes : états avec seeds + notes de sécurité (transmises de vive voix, jamais commitées)
probes/state-*.json
SECURITY-NOTES.md

# sondes exploratoires
probes*/*.log

# miroir local du build (la cible Vercel est apps/web/public + apps/web/dist)
apps/web/out/
/public/
.vercel

# supports de scène, pas des livrables — restent en local
DECK.pdf
DECK.tex
DEMO.md
~$*
